{
  "name": "hostinger-ops",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "infra:up": "docker compose --env-file .env -f infra/docker-compose.yml up -d --wait",
    "infra:down": "docker compose --env-file .env -f infra/docker-compose.yml down",
    "db:generate": "corepack pnpm --filter @ops/database generate",
    "db:migrate": "corepack pnpm --filter @ops/database migrate",
    "typecheck": "tsc -b",
    "build": "tsc -b",
    "test": "tsc -b && vitest run",
    "dev:api": "corepack pnpm --filter @ops/api dev",
    "ops:secret:set": "node apps/api/dist/cli/secret-set.js",
    "ops:login:add": "node apps/api/dist/cli/login-add.js",
    "ops:ui:password": "node apps/api/dist/cli/ui-password.js"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.0"
  }
}
